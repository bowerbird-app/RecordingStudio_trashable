<% content_for :title, trashable_t("home.title") %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: recording_studio_trashable_back_path,
  anchor_href: recording_studio_trashable_host_root_path,
  anchor_tooltip: trashable_t("home.close")
) %>

<div class="flex flex-col gap-8">
  <section id="capabilities" aria-labelledby="capabilities-title" class="flex flex-col gap-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: trashable_t("home.capabilities.title"),
      anchor_link: true,
      anchor_id: "capabilities"
    ) %>

    <%= render FlatPack::Card::Component.new(background: :default, border: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: trashable_t("home.capabilities.owns_title"),
          subtitle: trashable_t("home.capabilities.owns_subtitle"),
          variant: :h3
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="flex flex-col gap-3 leading-relaxed">
          <li><code>recording_studio_trashable_trash!</code> <%= trashable_t("home.capabilities.trash") %></li>
          <li><code>recording_studio_trashable_restore!</code> <%= trashable_t("home.capabilities.restore") %></li>
          <li><code>recording_studio_trashable_purge!</code> <%= trashable_t("home.capabilities.purge") %></li>
          <li><%= trashable_t("home.capabilities.query_helpers") %></li>
          <li><%= trashable_t("home.capabilities.keep_for") %></li>
        </ul>
      <% end %>
    <% end %>
  </section>

  <section id="authorization" aria-labelledby="authorization-title" class="flex flex-col gap-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: trashable_t("home.authorization.title"),
      anchor_link: true,
      anchor_id: "authorization"
    ) %>

    <%= render FlatPack::Card::Component.new(background: :none, border: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: trashable_t("home.authorization.default_title"),
          subtitle: trashable_t("home.authorization.default_subtitle"),
          variant: :h3
        ) %>
      <% end %>

      <% card.body do %>
        <dl class="flex flex-col gap-3 leading-relaxed">
          <% @configuration.authorization_roles.each do |action, role| %>
            <div class="flex flex-wrap items-baseline gap-2">
              <dt class="font-medium"><%= RecordingStudioTrashable::Copy.action_name(action) %></dt>
              <dd><%= role %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    <% end %>
  </section>
</div>
