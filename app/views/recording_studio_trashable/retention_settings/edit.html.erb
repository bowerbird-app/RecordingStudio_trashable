<div>
  <%= render FlatPack::PageNav::Component.new(
    anchor_url: recording_studio_trashable_back_path,
    class: "mb-4"
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Retention period",
    subtitle: "Number of days to keep trashed items.",
    variant: :h1
  ) %>

  <% retention_options = [
       ["Keep until manually purged", ""],
       ["7 days", 7],
       ["14 days", 14],
       ["30 days", 30],
       ["60 days", 60],
       ["90 days", 90]
     ] %>
  <% current_purge_after_days = @retention_setting.purge_after_days %>
  <% unless current_purge_after_days.blank? || retention_options.any? { |(_, value)| value == current_purge_after_days } %>
    <% retention_options << ["#{current_purge_after_days} days", current_purge_after_days] %>
  <% end %>

  <section aria-label="Retention period" class="max-w-md">
    <% if @retention_setting.errors.any? %>
      <%= render FlatPack::Alert::Component.new(
        title: "Could not save retention settings",
        description: @retention_setting.errors.full_messages.to_sentence,
        style: :danger
      ) %>
    <% end %>

    <%= form_with(
          model: @retention_setting,
          url: recording_trash_settings_path(@scope_recording, recording_studio_trashable_back_link_params),
          method: :patch
        ) do |form| %>
      <div class="space-y-4">
        <%= render FlatPack::Select::Component.new(
          name: "#{form.object_name}[purge_after_days]",
          options: retention_options,
          value: current_purge_after_days,
          label: "Retention period",
          placeholder: nil,
          error: @retention_setting.errors.full_messages_for(:purge_after_days).to_sentence.presence
        ) %>

        <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, type: "submit") %>
      </div>
    <% end %>
  </section>
</div>
