<% recording_studio_page_nav(
  title: trashable_t("retention.title", default: "Retention period"),
  page_nav_back_url: recording_studio_trashable_back_path,
  page_nav_anchor_url: recording_studio_trashable_back_path,
  page_nav_anchor_label: trashable_t("retention.close", default: "Close")
) %>

<div class="flex flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: trashable_t("retention.title", default: "Retention period"),
    subtitle: trashable_t("retention.subtitle", default: "Number of days to keep trashed items."),
    variant: :h1
  ) %>

  <% retention_day_default = { one: "%{count} day", other: "%{count} days" } %>
  <% retention_options = [
       [trashable_t("retention.keep_until_purged", default: "Keep until manually purged"), ""],
       [trashable_t("retention.days", count: 7, default: retention_day_default), 7],
       [trashable_t("retention.days", count: 14, default: retention_day_default), 14],
       [trashable_t("retention.days", count: 30, default: retention_day_default), 30],
       [trashable_t("retention.days", count: 60, default: retention_day_default), 60],
       [trashable_t("retention.days", count: 90, default: retention_day_default), 90]
     ] %>
  <% current_purge_after_days = @retention_setting.purge_after_days %>
  <% unless current_purge_after_days.blank? || retention_options.any? { |(_, value)| value == current_purge_after_days } %>
    <% retention_options << [trashable_t("retention.days", count: current_purge_after_days, default: retention_day_default), current_purge_after_days] %>
  <% end %>

  <section aria-label="<%= trashable_t("retention.title", default: "Retention period") %>" class="max-w-md">
    <% if @retention_setting.errors.any? %>
      <%= render FlatPack::Alert::Component.new(
        title: trashable_t("errors.could_not_save_retention", default: "Could not save retention settings"),
        description: @retention_setting.errors.full_messages.to_sentence,
        style: :danger
      ) %>
    <% end %>

    <%= form_with(
          model: @retention_setting,
          url: recording_trash_settings_path(@scope_recording, recording_studio_trashable_back_link_params),
          method: :patch
        ) do |form| %>
      <div class="space-y-4">
        <%= render FlatPack::Select::Component.new(
          name: "#{form.object_name}[purge_after_days]",
          options: retention_options,
          value: current_purge_after_days,
          label: trashable_t("retention.label", default: "Retention period"),
          placeholder: nil,
          error: @retention_setting.errors.full_messages_for(:purge_after_days).to_sentence.presence
        ) %>

        <%= render FlatPack::Button::Component.new(text: trashable_t("retention.save", default: "Save"), style: :primary, type: "submit") %>
      </div>
    <% end %>
  </section>
</div>
