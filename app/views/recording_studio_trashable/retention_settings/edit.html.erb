<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <nav aria-label="Breadcrumb" class="text-sm text-(--surface-muted-content-color)">
    <%= render FlatPack::Button::Component.new(
      text: "Back",
      icon: "arrow-left",
      style: :ghost,
      url: recording_studio_trashable_back_path
    ) %>
  </nav>

  <div class="flex flex-col gap-4">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Retention period",
      subtitle: "Number of days to keep trashed items.",
      variant: :h1
    ) %>
  </div>

  <% retention_options = [
       ["Keep until manually purged", ""],
       ["7 days", 7],
       ["14 days", 14],
       ["30 days", 30],
       ["60 days", 60],
       ["90 days", 90]
     ] %>
  <% current_purge_after_days = @retention_setting.purge_after_days %>
  <% unless current_purge_after_days.blank? || retention_options.any? { |(_, value)| value == current_purge_after_days } %>
    <% retention_options << ["#{current_purge_after_days} days", current_purge_after_days] %>
  <% end %>

  <section class="max-w-xl space-y-4" aria-label="Retention period">
    <% if @retention_setting.errors.any? %>
      <%= render FlatPack::Alert::Component.new(
        title: "Could not save retention settings",
        description: @retention_setting.errors.full_messages.to_sentence,
        style: :danger
      ) %>
    <% end %>

    <%= form_with(
          model: @retention_setting,
          url: recording_trash_settings_path(@scope_recording, recording_studio_trashable_back_link_params),
          method: :patch,
          class: "space-y-4"
        ) do |form| %>
      <div class="space-y-2">
        <%= form.label :purge_after_days, "Retention period", class: "block text-sm font-medium" %>
        <%= form.select :purge_after_days,
                        options_for_select(retention_options, current_purge_after_days),
                        {},
                        class: "w-full rounded-lg border border-[var(--card-border-color)] bg-[var(--card-background-color)] px-3 py-2 text-sm" %>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, type: "submit") %>
      </div>
    <% end %>
  </section>
</div>
