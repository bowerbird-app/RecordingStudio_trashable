<% recording_studio_page_nav(
  title: "Trash",
  page_nav_back_url: recording_studio_trashable_back_path,
  page_nav_anchor_url: recording_studio_trashable_back_path,
  page_nav_anchor_label: "Close"
) %>

<div class="flex flex-col gap-6" data-controller="recording-studio-trashable--live-search">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Trash",
    subtitle: "Recently trashed roots",
    variant: :h1
  ) %>

  <% if recording_studio_trashable_retention_settings_enabled? &&
        recording_studio_trashable_page_authorized?(:settings, recording: @scope_recording) %>
    <p>
      <%= render FlatPack::Button::Component.new(
        text: "Trash settings",
        style: :secondary,
        url: edit_recording_trash_settings_path(@scope_recording, recording_studio_trashable_back_link_params)
      ) %>
    </p>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <%= form_with url: recording_trash_bin_path(@scope_recording),
                    method: :get,
                    data: {
                      recording_studio_trashable__live_search_target: "form",
                      action: "input->recording-studio-trashable--live-search#queueSubmit search->recording-studio-trashable--live-search#queueSubmit",
                      turbo_frame: "trash-bin-results",
                      recording_studio_trashable__live_search_delay_value: 250
                    } do %>
        <%= hidden_field_tag :back_path, recording_studio_trashable_back_path %>
        <%= render FlatPack::SearchInput::Component.new(
          name: :q,
          value: @search_query,
          placeholder: "Search trash",
          id: "trash-bin-search"
        ) %>
      <% end %>

      <div hidden data-recording-studio-trashable--live-search-target="skeleton">
        <% 5.times do %>
          <p><%= render FlatPack::Skeleton::Component.new(variant: :text) %></p>
        <% end %>
        <p><%= render FlatPack::Skeleton::Component.new(variant: :button) %></p>
        <p><%= render FlatPack::Skeleton::Component.new(variant: :button) %></p>
      </div>

      <%= turbo_frame_tag "trash-bin-results",
                          data: {
                            recording_studio_trashable__live_search_target: "frame",
                            action: "turbo:before-fetch-request->recording-studio-trashable--live-search#showLoading turbo:frame-load->recording-studio-trashable--live-search#hideLoading"
                          } do %>
        <% if @trashed_recordings.empty? %>
          <%= render FlatPack::Alert::Component.new(
            description: @search_query.present? ? "No trash roots match your search." : "No trash roots.",
            style: :info
          ) %>
        <% else %>
          <%= render FlatPack::Table::Component.new(
            data: @trashed_recordings,
            tbody_data: { pagination_content: true }
          ) do |table| %>
            <% table.column(title: "Name", html: ->(recording) { recording_studio_trashable_recording_label(recording) }) %>
            <% table.column(title: "Type", html: ->(recording) { recording.recordable_type }) %>
            <% table.column(
                 title: "Trashed",
                 html: lambda { |recording|
                   trashed_at_trigger_id = "trashed-at-#{recording.id}"
                   safe_join([
                     button_tag(
                       "#{time_ago_in_words(recording.trashed_at)} ago",
                       id: trashed_at_trigger_id,
                       type: "button"
                     ),
                     render(
                       FlatPack::Popover::Component.new(trigger_id: trashed_at_trigger_id, placement: :top) do |popover|
                         popover.content { l(recording.trashed_at, format: :long) }
                       end
                     )
                   ])
                 }
               ) %>
            <% table.column(
                 title: "Action",
                 html: lambda { |recording|
                   actions = []

                   if recording_studio_trashable_action_authorized?(:restore, recording)
                     actions << form_with(
                       url: restore_recording_path(recording),
                       method: :patch,
                       data: { turbo: false },
                       html: { class: "shrink-0" }
                     ) do
                       safe_join([
                         hidden_field_tag(:back_path, recording_studio_trashable_back_path),
                         render(FlatPack::Button::Component.new(text: "Restore", style: :secondary, type: "submit"))
                       ])
                     end
                   end

                   if recording_studio_trashable_action_authorized?(:purge, recording)
                     actions << form_with(
                       url: purge_recording_path(recording),
                       method: :delete,
                       data: { turbo: false },
                       html: { class: "shrink-0" }
                     ) do
                       safe_join([
                         hidden_field_tag(:back_path, recording_studio_trashable_back_path),
                         render(FlatPack::Button::Component.new(text: "Purge", style: :danger, type: "submit"))
                       ])
                     end
                   end

                   content_tag(:div, safe_join(actions), class: "flex flex-wrap items-center gap-2 xl:flex-nowrap")
                 }
               ) %>
          <% end %>

          <%= render FlatPack::Pagination::Component.new(
            pagy: @pagy,
            mode: :infinite,
            loading_variant: :table
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
