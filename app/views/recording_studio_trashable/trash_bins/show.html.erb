<% recording_studio_page_nav(
  title: trashable_t("trash.title"),
  page_nav_back_url: recording_studio_trashable_back_path,
  page_nav_anchor_url: recording_studio_trashable_back_path,
  page_nav_anchor_label: trashable_t("trash.close")
) %>

<%= render FlatPack::Grid::Component.new(
  cols: 1,
  gap: :lg,
  data: { controller: "recording-studio-trashable--live-search" }
) do %>
  <%= render FlatPack::PageTitle::Component.new(title: trashable_t("trash.title"), variant: :h1) do |page_title| %>
    <% if recording_studio_trashable_retention_settings_enabled? &&
          recording_studio_trashable_page_authorized?(:settings, recording: @scope_recording) %>
      <% page_title.slot do %>
        <%= render FlatPack::Button::Component.new(
          text: trashable_t("trash.settings"),
          icon: :cog,
          style: :secondary,
          href: edit_recording_trash_settings_path(@scope_recording, recording_studio_trashable_back_link_params)
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
    <%= form_with url: recording_trash_bin_path(@scope_recording),
                  method: :get,
                  data: {
                    recording_studio_trashable__live_search_target: "form",
                    action: "input->recording-studio-trashable--live-search#queueSubmit search->recording-studio-trashable--live-search#queueSubmit",
                    turbo_frame: "trash-bin-results",
                    recording_studio_trashable__live_search_delay_value: 250
                  } do %>
      <%= hidden_field_tag :back_path, recording_studio_trashable_back_path %>
      <%= render FlatPack::SearchInput::Component.new(
        name: :q,
        value: @search_query,
        placeholder: trashable_t("trash.search_placeholder"),
        id: "trash-bin-search"
      ) %>
    <% end %>

    <div hidden data-recording-studio-trashable--live-search-target="skeleton">
      <% 5.times do %>
        <%= render FlatPack::Skeleton::Component.new(variant: :text) %>
      <% end %>
      <%= render FlatPack::Skeleton::Component.new(variant: :button) %>
      <%= render FlatPack::Skeleton::Component.new(variant: :button) %>
    </div>

    <%= turbo_frame_tag "trash-bin-results",
                        data: {
                          recording_studio_trashable__live_search_target: "frame",
                          action: "turbo:before-fetch-request->recording-studio-trashable--live-search#showLoading turbo:frame-load->recording-studio-trashable--live-search#hideLoading"
                        } do %>
      <% if @trashed_recordings.empty? %>
        <%= render FlatPack::Alert::Component.new(
          description: @search_query.present? ? trashable_t("trash.empty_search") : trashable_t("trash.empty"),
          style: :info
        ) %>
      <% else %>
        <%= render FlatPack::Table::Component.new(
          data: @trashed_recordings,
          tbody_data: { pagination_content: true }
        ) do |table| %>
          <% table.column(title: trashable_t("trash.columns.name"), html: ->(recording) { recording_studio_trashable_recording_label(recording) }) %>
          <% table.column(title: trashable_t("trash.columns.type"), html: ->(recording) { recording.recordable_type }) %>
          <% table.column(
               title: trashable_t("trash.columns.trashed"),
               html: lambda { |recording|
                 render FlatPack::Timestamp::Component.new(
                   timestamp: recording.trashed_at,
                   tooltip_placement: :top
                 )
               }
             ) %>
          <% table.column(
               title: trashable_t("trash.columns.action"),
               html: lambda { |recording|
                 actions = []
                 label = recording_studio_trashable_recording_label(recording)

                 if recording_studio_trashable_action_authorized?(:restore, recording)
                   actions << form_with(
                     url: restore_recording_path(recording),
                     method: :patch,
                     data: { turbo: false, confirm: trashable_t("confirms.restore", name: label) },
                     html: recording_studio_trashable_confirm_form_html("confirms.restore", name: label)
                   ) do
                     safe_join([
                       hidden_field_tag(:back_path, recording_studio_trashable_back_path),
                       render(FlatPack::Button::Component.new(text: trashable_t("trash.restore"), style: :secondary, type: "submit"))
                     ])
                   end
                 end

                 if recording_studio_trashable_action_authorized?(:purge, recording)
                   actions << form_with(
                     url: purge_recording_path(recording),
                     method: :delete,
                     data: { turbo: false, confirm: trashable_t("confirms.purge", name: label) },
                     html: recording_studio_trashable_confirm_form_html("confirms.purge", name: label)
                   ) do
                     safe_join([
                       hidden_field_tag(:back_path, recording_studio_trashable_back_path),
                       render(FlatPack::Button::Component.new(text: trashable_t("trash.purge"), style: :danger, type: "submit"))
                     ])
                   end
                 end

                 content_tag(:div, safe_join(actions), class: "flex flex-wrap items-center gap-2 xl:flex-nowrap")
               }
             ) %>
        <% end %>

        <%= render FlatPack::Pagination::Component.new(
          pagy: @pagy,
          mode: :infinite,
          loading_variant: :table
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
