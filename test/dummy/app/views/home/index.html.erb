<% recording_studio_page_nav(
  title: "Trash demo",
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: "Home"
) %>

<% recording_studio_page_nav_right do %>
  <%= render FlatPack::Button::Component.new(
    text: "Sign out",
    style: :ghost,
    url: main_app.destroy_user_session_path,
    data: { turbo_method: :delete }
  ) %>
<% end %>

<div class="flex flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Trash demo",
    subtitle: "Recording Studio Trash functionality",
    variant: :h1
  ) %>

  <% if @workspace_recording %>
    <div class="flex flex-wrap gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "Trash can",
        style: :primary,
        url: recording_studio_trashable.recording_trash_bin_path(
          @workspace_recording,
          back_path: main_app.root_path
        )
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Trash settings",
        style: :secondary,
        url: recording_studio_trashable.edit_recording_trash_settings_path(
          @workspace_recording,
          back_path: main_app.root_path
        )
      ) %>
      <% if @can_purge_due %>
        <%= form_with url: main_app.purge_due_recordings_path, method: :post, data: { turbo: false } do %>
          <%= render FlatPack::Button::Component.new(text: "Purge", style: :danger, type: "submit") %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render FlatPack::Table::Component.new(data: @table_recordings) do |table| %>
    <% table.column(
         title: "name",
         html: lambda { |recording|
           recording.recordable.respond_to?(:title) ?
             recording.recordable.title :
             recording.recordable.respond_to?(:name) ? recording.recordable.name : recording.recordable_type
         }
       ) %>
    <% table.column(title: "type", html: ->(recording) { recording.recordable_type }) %>
    <% table.column(title: "trash root", html: ->(recording) { recording.trash_root? ? "yes" : "no" }) %>
    <% table.column(
         title: "status",
         html: lambda { |recording|
           status = recording.trashed_at.present? ? "trashed" : "active"
           style = recording.trashed_at.present? ? :warning : :success
           render FlatPack::Badge::Component.new(text: status, style: style, size: :sm)
         }
       ) %>
    <% table.column(
         title: "action",
         html: lambda { |recording|
           actions = []

           if recording.recordable_type == "Page" && recording.trashed_at.blank?
             actions << form_with(
               url: recording_studio_trashable.trash_recording_path(recording),
               method: :patch,
               data: { turbo: false },
               html: { class: "shrink-0" }
             ) do
               safe_join([
                 hidden_field_tag(:back_path, request.fullpath),
                 render(FlatPack::Button::Component.new(text: "Trash", style: :primary, type: "submit"))
               ])
             end
           elsif recording.recordable_type == "Page"
             actions << form_with(
               url: recording_studio_trashable.restore_recording_path(recording),
               method: :patch,
               data: { turbo: false },
               html: { class: "shrink-0" }
             ) do
               safe_join([
                 hidden_field_tag(:back_path, request.fullpath),
                 render(FlatPack::Button::Component.new(text: "Restore", style: :secondary, type: "submit"))
               ])
             end
             actions << form_with(
               url: recording_studio_trashable.purge_recording_path(recording),
               method: :delete,
               data: { turbo: false },
               html: { class: "shrink-0" }
             ) do
               safe_join([
                 hidden_field_tag(:back_path, request.fullpath),
                 render(FlatPack::Button::Component.new(text: "Purge", style: :danger, type: "submit"))
               ])
             end
           else
             trigger_id = "trash-not-enabled-#{recording.id}"
             actions << render(
               FlatPack::Button::Component.new(
                 text: "Trash not enabled",
                 style: :ghost,
                 type: "button",
                 id: trigger_id
               )
             )
             actions << render(
               FlatPack::Popover::Component.new(trigger_id: trigger_id, placement: :top) do |popover|
                 popover.content { "This recordable type has not had trash enabled." }
               end
             )
           end

           content_tag(:div, safe_join(actions), class: "flex flex-wrap items-center gap-2 xl:flex-nowrap")
         }
       ) %>
  <% end %>

  <section class="flex flex-col gap-4" aria-labelledby="docs-title">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Docs",
      subtitle: "Setup, settings, and how trash works in this demo."
    ) %>

    <div class="flex flex-wrap gap-3">
      <% demo_doc_links.each do |link| %>
        <%= render FlatPack::Button::Component.new(
          text: link.fetch(:text),
          style: :secondary,
          url: link.fetch(:url)
        ) %>
      <% end %>
    </div>
  </section>
</div>
