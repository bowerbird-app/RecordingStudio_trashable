<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Trashable Demo",
      subtitle: "Recording Studio"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Home", href: main_app.root_path, icon: :home) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Overview", href: main_app.showcase_path("overview"), icon: :dashboard) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Setup", href: main_app.showcase_path("setup"), icon: :settings) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Configuration", href: main_app.showcase_path("configuration"), icon: :cog) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Adding to a recordable", href: main_app.showcase_path("adding-to-a-recordable"), icon: :plus) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Trash cans", href: main_app.showcase_path("trash-cans"), icon: :trash) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Trash roots", href: main_app.showcase_path("trash-roots"), icon: :table) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Retention", href: main_app.showcase_path("retention"), icon: :settings) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Events", href: main_app.events_path, icon: :table) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Responses", href: main_app.showcase_path("responses"), icon: :link) %>
      <%= render FlatPack::Sidebar::Item::Component.new(text: "Methods", href: main_app.showcase_path("methods"), icon: :file) %>
    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :lock,
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
